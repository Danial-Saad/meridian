<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode counterpart of ../values-v31/styles.xml — see that file for
  why this exists at all. Resource qualifiers combine (night + v31), so
  this is the one actually used on an Android 12+ device with system Dark
  Mode on; the light version above covers Android 12+ in light mode.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
